{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "auth": {
      "mode": "token"
    }
  },
  "plugins": {
    "allow": ["whatsapp"],
    "entries": {
      "whatsapp": {
        "enabled": true
      }
    }
  },
  "channels": {
    "whatsapp": {
      "enabled": true,
      "accounts": {
        "default": {
          "name": "Nexus-Grid",
          "enabled": true
        }
      },
      "dmPolicy": "allowlist",
      "allowFrom": [],
      "groupPolicy": "disabled"
    }
  }
}
