DATABASE_URL=postgresql://postgres:postgres@db:5432/nexus
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=
CMDOP_API_KEY=

# Backend selection: memory needs no services; redis/postgres are durable
# and shared across replicas
EVENT_BUS_BACKEND=memory
CHECKPOINTER_BACKEND=memory
CHECKPOINTER_SQLITE_PATH=data/checkpoints.db
RATE_LIMIT_BACKEND=memory

ENVIRONMENT=development
LOG_LEVEL=INFO
SKIP_AGENT_STARTUP=0
AGENT_POLL_INTERVAL_SECONDS=10

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=120
