# Copy to .env.local and fill in. Every value has a working default, so the
# app runs with no configuration at all.

# --- LLM provider for the workflow's recommendation step -------------------
# Without a key the recommend node returns a labelled stub instead of calling out.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2

# Alternative OpenAI-compatible provider, used when MINIMAX_API_KEY is empty
SHO_API_KEY=
SHO_BASE_URL=
SHO_MODEL=

# --- Agent runtime ---------------------------------------------------------
SKIP_AGENT_STARTUP=0
AGENT_POLL_INTERVAL_SECONDS=10

# --- Security --------------------------------------------------------------
# Set a 32+ byte value in every real environment; the default is dev-only.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=120

# --- App -------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
