# Copy to .env.local. Every value except the sign-in block has a working
# default — the sources are public and keyless. The console itself stays shut
# until sign-in is configured (see "Authentication" below).
#
# NOTE for production: `next build` snapshots the .env files it sees, so a
# value added to .env *after* a build is not picked up by `next start`. Either
# rebuild, or set real environment variables — which is what a deployment
# should do anyway.

# --- Authentication (Auth.js) -----------------------------------------------
# Signs the session cookie. Generate with `npx auth secret` or
# `openssl rand -base64 32`. Required: without it the console stays closed.
AUTH_SECRET=

# Behind your own reverse proxy (the compose stack), set the public URL and
# trust the proxy's host header. Vercel sets both itself.
# AUTH_URL=https://nexus.example.com
# AUTH_TRUST_HOST=true

# Identity providers: set any one or more. Register the callback URL
# https://<host>/api/auth/callback/<id> with the provider, where <id> is
# microsoft-entra-id, oidc, google or github.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Okta, Auth0, Keycloak or any other OIDC issuer
AUTH_OIDC_ISSUER=
AUTH_OIDC_ID=
AUTH_OIDC_SECRET=
AUTH_OIDC_NAME=Single sign-on

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Who may sign in, and as what. Comma-separated, case-insensitive. Anyone on
# no list and outside every allowed domain is refused.
#   viewer   reads everything
#   operator also runs sweeps and decides approval gates
#   admin    also reads /api/metrics
AUTH_ADMIN_EMAILS=
AUTH_OPERATOR_EMAILS=
AUTH_VIEWER_EMAILS=
# Every verified address at these domains gets AUTH_DEFAULT_ROLE (viewer).
AUTH_ALLOWED_DOMAINS=
AUTH_DEFAULT_ROLE=viewer

# Service accounts for integrations, scrapers and CI: name:role:sha256 entries,
# comma-separated. Mint one with `npm run token:new -- <name> <role>` and call
# the API with `Authorization: Bearer <token>`.
AUTH_API_TOKENS=

# Local development only (`npm run dev`): a one-click sign-in that needs no
# provider. Ignored by every production build.
# AUTH_DEV_LOGIN=1
# AUTH_DEV_ROLE=admin

# Demo accounts: "Sign in as Viewer / Operator / Admin" buttons on the sign-in
# page, for showing the console to people who are not on the access list.
# Unlike the development sign-in this WORKS IN PRODUCTION, so anyone who can
# open the sign-in page gets in, as any role. Needs AUTH_SECRET; no provider is
# required. Demo accounts can't see or change who has access.
# AUTH_DEMO_LOGIN=1

# --- LLM provider for the interpretation and recommendation steps ----------
# Without a key both fall back to labelled rule-derived output rather than
# failing, so the platform still works; it just stops interpreting.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2

# Alternative OpenAI-compatible provider, used when MINIMAX_API_KEY is empty
SHO_API_KEY=
SHO_BASE_URL=
SHO_MODEL=

# --- Database (optional) ---------------------------------------------------
# Postgres for the audit trail, the agents' decision log, access granted from
# the console, and paused workflow runs. Without it those stay in process
# memory, which on Vercel means an approval gate only works if the decision
# lands on the same instance. Neon, Vercel Postgres, Supabase, RDS or the
# compose stack's `postgres` profile all work; use the pooled URL on Vercel.
# DATABASE_URL=postgresql://user:password@host:5432/nexus?sslmode=require
# Connections per instance (default 5).
# DATABASE_POOL_MAX=5
# Instances apply migrations on first use. Set to 0 to run `npm run db:migrate`
# yourself instead, for example as a release step.
# DATABASE_AUTO_MIGRATE=1
# Only for the compose stack's `postgres` profile.
# POSTGRES_PASSWORD=

# --- Workflow checkpointer -------------------------------------------------
# Where paused runs are kept when DATABASE_URL is not set. A file path means an approval gate survives a
# restart — a human takes human time over a decision, and an in-memory
# checkpointer loses it on the next deploy. Set to empty for in-memory.
CHECKPOINT_DB_PATH=.nexus-grid/checkpoints.sqlite

# --- Agent runtime ---------------------------------------------------------
# The scan sweeps the regional picture and opens a coordination run per
# material sourcing gap. Set SKIP_AGENT_STARTUP=1 to disable it.
SKIP_AGENT_STARTUP=0
AGENT_POLL_INTERVAL_SECONDS=10

# --- Delivery (OpenClaw dashboard) ------------------------------------------
# Where an approved plan goes: the gateway's dashboard (Control UI) session,
# for an operator to read. No phone number and no outside channel is involved.
# Leave these empty and the execute step honestly reports its dispatch as
# simulated rather than claiming a delivery.
#
# The URL must be loopback. The gateway grants a shared-token connection its
# operator scopes only from 127.0.0.1, so docker-compose.yml runs the app
# inside the gateway's own network namespace; reached by service name the app
# authenticates and is then allowed nothing.
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
# The dashboard session plans are posted into, and the agent it belongs to.
OPENCLAW_SESSION_KEY=main
OPENCLAW_AGENT_ID=main

# --- Limits ----------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120

# --- App -------------------------------------------------------------------
APP_NAME=Nexus-Grid
APP_VERSION=1.0
ENVIRONMENT=development
