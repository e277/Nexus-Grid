# Copy to .env.local. Every value has a working default, so the app runs with
# no configuration at all — the sources are public and keyless.
#
# NOTE for production: `next build` snapshots the .env files it sees, so a
# value added to .env *after* a build is not picked up by `next start`. Either
# rebuild, or set real environment variables — which is what a deployment
# should do anyway.

# --- LLM provider for the interpretation and recommendation steps ----------
# Without a key both fall back to labelled rule-derived output rather than
# failing, so the platform still works; it just stops interpreting.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2

# Alternative OpenAI-compatible provider, used when MINIMAX_API_KEY is empty
SHO_API_KEY=
SHO_BASE_URL=
SHO_MODEL=

# --- Workflow checkpointer -------------------------------------------------
# Where paused runs are kept. A file path means an approval gate survives a
# restart — a human takes human time over a decision, and an in-memory
# checkpointer loses it on the next deploy. Set to empty for in-memory.
CHECKPOINT_DB_PATH=.nexus-grid/checkpoints.sqlite

# --- Plan delivery (OpenClaw gateway) --------------------------------------
# The execute node delivers an approved plan through a running OpenClaw
# gateway — a separate process that owns the channels a ministry desk reads
# (Slack, WhatsApp, Signal, …). This app calls its HTTP tool surface; it does
# not embed the gateway.
#
# Without all three of URL, TOKEN and TARGET the node reports `unconfigured`
# and labels the dispatch simulated rather than pretending to have sent.
# The token is full operator access on that gateway, so keep the gateway on a
# private ingress and the token out of source control.
#
# For WhatsApp: pair the channel on the gateway (`openclaw onboard`), then set
# OPENCLAW_TARGET to the recipient in international form, e.g. +18685550123.
# The gateway owns the WhatsApp session; this app only asks it to send.
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_TARGET=
OPENCLAW_AGENT_ID=main

# --- Agent runtime ---------------------------------------------------------
# The scan sweeps the regional picture and opens a coordination run per
# material sourcing gap. Set SKIP_AGENT_STARTUP=1 to disable it.
SKIP_AGENT_STARTUP=0
AGENT_POLL_INTERVAL_SECONDS=10

# --- Limits ----------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120

# --- App -------------------------------------------------------------------
APP_NAME=Nexus-Grid
APP_VERSION=1.0
ENVIRONMENT=development
