# /etc/nexus-grid/nexus-grid.env — EnvironmentFile for nexus-grid.service.
#
# Mode 0640, owned root:nexus-grid. systemd reads it as EnvironmentFile=
# and merges the keys with the second EnvironmentFile (/etc/openclaw/gateway.token).
#
# The gateway token NEVER lives here — it lives in /etc/openclaw/gateway.token
# (mode 0640 root:openclaw). systemd merges the two EnvironmentFiles in
# declaration order so the token is loaded as OPENCLAW_GATEWAY_TOKEN without
# ever appearing in this file.
#
# Every key listed in .env.example at the repo root is read by the app at
# startup. Values left at the example defaults are honoured; for production
# at minimum set the four values below.

# ─── Required for production ────────────────────────────────────────────────
ENVIRONMENT=production
CHECKPOINT_DB_PATH=/opt/nexus-grid/.nexus-grid/checkpoints.sqlite
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN is intentionally NOT here — see
# /etc/openclaw/gateway.token (mode 0640 root:openclaw) which is merged by
# systemd into the same EnvironmentFile chain.

# ─── App settings (defaults are fine to ship with) ──────────────────────────
APP_NAME=Nexus-Grid
APP_VERSION=1.0
RATE_LIMIT_PER_MINUTE=120
SKIP_AGENT_STARTUP=false
AGENT_POLL_INTERVAL_SECONDS=10

# ─── LLM provider (optional — without keys the LLM step is rule-derived) ───
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_MODEL=MiniMax-M2
# SHO_API_KEY=
# SHO_BASE_URL=
# SHO_MODEL=

# ─── OpenClaw session routing (defaults match the gateway's own) ────────────
OPENCLAW_SESSION_KEY=main
OPENCLAW_AGENT_ID=main
