{
  "name": "nexus-grid",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 5180",
    "build": "next build",
    "start": "next start -p 5180",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:geo": "node scripts/build-caricom-geometry.mjs",
    "gateway:up": "docker compose --env-file .env -f openclaw/docker-compose.yml up -d",
    "gateway:down": "docker compose --env-file .env -f openclaw/docker-compose.yml down",
    "gateway:watch": "docker compose --env-file .env -f openclaw/docker-compose.yml watch",
    "gateway:cli": "docker compose --env-file .env -f openclaw/docker-compose.yml run --rm cli"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.9",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.3",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "topojson-client": "^3.1.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10",
    "world-atlas": "^2.0.2"
  }
}
